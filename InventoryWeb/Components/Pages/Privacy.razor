@page "/privacy"
@layout InventoryWeb.Components.Layout.LoginLayout
<PageTitle>Privacy Policy</PageTitle>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Privacy Policy</h3>
    </div>

    <div class="card-body">

        <p>
            Inventory SaaS respects the privacy of all users.
        </p>

        <p>
            We collect store information, product data,
            inventory data, and marketplace order data
            solely for inventory synchronization and
            operational purposes.
        </p>

        <p>
            We do not sell, rent, or distribute user data
            to third parties.
        </p>

        <p>
            All information is stored securely and only
            accessible by authorized users.
        </p>

        <p>
            Users may request account or data deletion
            by contacting the system administrator.
        </p>

        <p>
            Last Updated:
            @DateTime.Now.ToString("dd MMM yyyy")
        </p>

    </div>
</div>