@inherits LayoutComponentBase

@inject NavigationManager Nav


<div class="page">
    <header class="navbar navbar-expand-md d-print-none">
        <div class="container-xl">
            <a class="navbar-brand navbar-brand-autodark" href="/">
                <span class="avatar avatar-sm bg-primary text-white me-2">
                    <i class="ti ti-box"></i>
                </span>
                <span class="fw-bold">Inventory SaaS</span>
            </a>

            <div class="navbar-nav flex-row order-md-last">
                <div class="nav-item">
                    <a class="nav-link px-0">
                        <i class="ti ti-moon"></i>
                    </a>
                </div>

               <div class="nav-item dropdown ms-3">
                    <a class="nav-link dropdown-toggle d-flex lh-1 text-reset p-0"
                        data-bs-toggle="dropdown"
                        href="#"
                        role="button">

                      
                    </a>

                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">

                        <a class="dropdown-item" href="#">
                            Profile
                        </a>

                        <a class="dropdown-item" href="#">
                            Settings
                        </a>

                        <div class="dropdown-divider"></div>

                        <a class="dropdown-item text-danger"
                            href="#"
                           >
                            <i class="ti ti-logout me-2"></i>
                            Logout
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </header>

    <header class="navbar-expand-md">
        <div class="collapse navbar-collapse show">
            <div class="navbar">
                <div class="container-xl">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-home"></i>
                                </span>
                                <span class="nav-link-title">Dashboard</span>
                            </NavLink>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#navbar-Inventory"
                               data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-package"></i>
                                </span>
                                <span class="nav-link-title">Inventory</span>
                            </a>

                            <div class="dropdown-menu">
                                <NavLink class="dropdown-item" href="/inventory">
                                    Dashboard
                                </NavLink>

                                <NavLink class="dropdown-item" href="/inventory/products">
                                    Products
                                </NavLink>
                                <NavLink class="dropdown-item" href="/inventory/stock">
                                    Product Stock
                                </NavLink>
                                <NavLink class="dropdown-item" href="/inventory/stock-card">
                                    Stock Card
                                </NavLink>
                                <NavLink class="dropdown-item" href="/inventory/low-stock">
                                    Low Stock
                                </NavLink>
                            </div>
                        </li>
                      
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/purchase/purchase">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-shopping-cart"></i>
                                </span>
                                <span class="nav-link-title">Purchase</span>
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/sales/sales">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-cash"></i>
                                </span>
                                <span class="nav-link-title">Sales</span>
                            </NavLink>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#navbar-marketplace"
                               data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-building-store"></i>
                                </span>
                                <span class="nav-link-title">Marketplace</span>
                            </a>

                            <div class="dropdown-menu">
                                <NavLink class="dropdown-item" href="/marketplace/marketplace">
                                    Dashboard
                                </NavLink>
                                <NavLink class="dropdown-item" href="/marketplace/products">
                                    Products
                                </NavLink>
                                <NavLink class="dropdown-item" href="/marketplace/channel">
                                    Channel
                                </NavLink>

                                <NavLink class="dropdown-item" href="/marketplace/mapping">
                                    SKU Mapping
                                </NavLink>

                                <NavLink class="dropdown-item" href="/marketplace/orders">
                                    Order Sync
                                </NavLink>

                                <NavLink class="dropdown-item" href="/marketplace/returns">
                                    Return / Reject
                                </NavLink>

                                <NavLink class="dropdown-item" href="/marketplace/sync-queue">
                                    Sync Queue
                                </NavLink>

                                <NavLink class="dropdown-item" href="/marketplace/logs">
                                    Sync Log
                                </NavLink>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <div class="page-wrapper">
        <div class="page-header d-print-none">
            <div class="container-xl">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <div class="page-pretitle">Overview</div>
                        <h2 class="page-title">Inventory</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                @Body
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
      
    }
   
}

